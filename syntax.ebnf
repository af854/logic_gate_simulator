network         = "DEVICES", { device }, 
                  "CONNECT", { connect }, 
                  "MONITOR", { monitor };

device          = name_list, "=", device_kind, ";" ;
name_list       = name, { ",", name } ;
device_kind     = parameterised_device, "(", number, ")" | fixed_device


parameterised_device = "AND" | "NAND" | "OR" | "NOR" | "CLOCK" | "SWITCH" ;
fixed_device = "DTYPE" | "XOR" ;

connect = input_signal_list, "<-", output_signal, ";" ;

input_signal_list = input_signal, { ",", input_signal } ;

input_signal = name, ".", input_pin ;

output_signal = name, [ ".", output_pin ] ;

monitor = output_signal, { ",", output_signal }, ";" ;

input_pin = "I", number
          | "DATA" | "CLK" | "SET" | "CLEAR" ;

output_pin = "Q" | "QBAR" ;

(* Lexical tokens handled by scanner *)
name          = letter , { letter | digit | "_" } ;
number        = digit , { digit } ;